---
// Override of Starlight's MobileMenuToggle: a plain icon button in the header (agentskills.io style)
// instead of a filled circle. Same popover target, so Starlight's menu behaviour is unchanged.
import { Icon } from '@astrojs/starlight/components';
---

<button popovertarget="starlight__sidebar" class="sl-menu-button md:sl-hidden print:hidden">
	<Icon name="bars" class="open-menu" />
	<Icon name="close" class="close-menu" />
	<span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
</button>

<style>
	button {
		position: fixed;
		top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
		inset-inline-end: var(--as-header-pad);
		z-index: var(--sl-z-index-navbar);
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--sl-menu-button-size);
		height: var(--sl-menu-button-size);
		border: 0;
		border-radius: 0.5rem;
		padding: 0;
		background: transparent;
		color: var(--as-icon-button);
		cursor: pointer;
	}
	button:hover {
		color: var(--sl-color-white);
	}
	button:has(~ :popover-open) .open-menu,
	button:not(:has(~ :popover-open)) .close-menu {
		display: none;
	}
	@media (min-width: 50rem) {
		button {
			display: none;
		}
	}
</style>

<style is:global>
	body:has(#starlight__sidebar:popover-open) {
		overflow: hidden;
	}
	@media (min-width: 50rem) {
		body:has(#starlight__sidebar:popover-open) {
			overflow: auto;
		}
	}
</style>
