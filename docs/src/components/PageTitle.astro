---
// Override of Starlight's PageTitle: the title with the Copy page menu beside it, the description
// under the title (as on agentskills.io), and the `numbered` frontmatter flag. Below a 520px
// content width the Copy page menu moves under the description, as there.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import CopyPageMenu from './CopyPageMenu.astro';
import { mdPathFor } from '../lib/paths.mjs';

const { entry, id } = Astro.locals.starlightRoute;
const { description, numbered } = entry.data as { description?: string; numbered?: boolean };
const mdPath = mdPathFor(id || entry.id);
---

<div class="page-title">
	<div class="page-title__grid">
		<Default />
		{description && <p class="page-description">{description}</p>}
		<CopyPageMenu mdPath={mdPath} />
	</div>
</div>
{numbered && <span class="numbered-flag" hidden />}

<style>
	.page-title {
		container-type: inline-size;
	}
	.page-title__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'title' 'description' 'copy';
		align-items: start;
		column-gap: 1rem;
	}
	.page-title__grid > :global(h1) {
		grid-area: title;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.page-title__grid > :global(copy-page) {
		grid-area: copy;
		justify-self: start;
		margin-top: 0.75rem;
	}
	.page-description {
		grid-area: description;
		margin-top: 0.5rem;
		font-size: var(--sl-text-lg);
		line-height: 1.75rem;
		color: var(--sl-color-gray-2);
	}
	@container (min-width: 520px) {
		.page-title__grid {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas: 'title copy' 'description description';
		}
		/* Centre the 2.125rem button on the title's first line. */
		.page-title__grid > :global(copy-page) {
			margin-top: calc((var(--as-h1-line) - 2.125rem) / 2);
		}
	}
</style>
