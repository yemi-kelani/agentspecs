---
// Override of Starlight's Sidebar: flat sections as on agentskills.io. Each run of top-level links is
// an unlabelled section, and each group is a section with a small bold label; groups do not collapse.
// A group nested inside a group renders as an indented label and list.
import { Badge } from '@astrojs/starlight/components';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
type Row = { kind: 'link'; entry: Extract<Entry, { type: 'link' }>; depth: number } | { kind: 'label'; label: string; depth: number };

const { sidebar } = Astro.locals.starlightRoute;

function rows(entries: Entry[], depth: number): Row[] {
	return entries.flatMap((entry): Row[] =>
		entry.type === 'link'
			? [{ kind: 'link', entry, depth }]
			: [{ kind: 'label', label: entry.label, depth }, ...rows(entry.entries, depth + 1)],
	);
}

const sections: { label?: string; rows: Row[] }[] = [];
for (const entry of sidebar) {
	const last = sections.at(-1);
	if (entry.type === 'link' && last && !last.label) last.rows.push({ kind: 'link', entry, depth: 0 });
	else if (entry.type === 'link') sections.push({ rows: [{ kind: 'link', entry, depth: 0 }] });
	else sections.push({ label: entry.label, rows: rows(entry.entries, 0) });
}
---

<SidebarPersister>
	{
		sections.map((section, i) => (
			<div class="sidebar-section">
				{section.label && (
					<p class="sidebar-group-label" id={`sidebar-group-${i}`}>
						{section.label}
					</p>
				)}
				<ul aria-labelledby={section.label ? `sidebar-group-${i}` : undefined} class:list={{ grouped: section.label }}>
					{section.rows.map((row) =>
						row.kind === 'label' ? (
							<li class="sidebar-subgroup-label" style={`--depth: ${row.depth}`}>
								{row.label}
							</li>
						) : (
							<li style={`--depth: ${row.depth}`}>
								<a
									href={row.entry.href}
									aria-current={row.entry.isCurrent ? 'page' : undefined}
									{...row.entry.attrs}
								>
									<span>{row.entry.label}</span>
									{row.entry.badge && (
										<Badge variant={row.entry.badge.variant} class={row.entry.badge.class} text={row.entry.badge.text} />
									)}
								</a>
							</li>
						),
					)}
				</ul>
			</div>
		))
	}
</SidebarPersister>
<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.sidebar-section + .sidebar-section {
		margin-top: 2rem;
	}
	.sidebar-group-label,
	.sidebar-subgroup-label {
		margin: 0 0 0.625rem;
		padding-inline-start: calc(1rem + 1rem * var(--depth, 0));
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.5rem;
		color: var(--as-sidebar-label);
	}
	.sidebar-subgroup-label {
		margin-top: 0.625rem;
	}
	ul {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul.grouped {
		gap: 1px;
	}
	a {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		min-height: 2.25rem;
		padding: 0.375rem 0.75rem 0.375rem calc(1rem + 1rem * var(--depth, 0));
		border-radius: 0.75rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5rem;
		color: var(--as-sidebar-link);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	a:hover {
		background-color: var(--as-hover-bg);
		color: var(--as-sidebar-link-hover);
	}
	a[aria-current='page'],
	a[aria-current='page']:hover {
		background-color: var(--as-active-bg);
		color: var(--as-active);
	}
	a:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -2px;
	}
</style>
