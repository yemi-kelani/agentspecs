---
// Override of Starlight's Header: agentskills.io layout. Site title on the left, search centred,
// the GitHub repository and the theme menu on the right, inside the same 92rem frame as the page.
// Below 50rem: title and search icon; the menu button (MobileMenuToggle) sits at the far right.
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { GITHUB_URL } from '../consts.mjs';

const repo = new URL(GITHUB_URL).pathname.replace(/^\/|\/$/g, '');
---

<div class="header-row">
	<div class="title-wrapper">
		<SiteTitle />
	</div>
	<div class="search-wrapper print:hidden">
		<Search />
	</div>
	<div class="right-group print:hidden">
		<a class="repo-link" href={GITHUB_URL}>
			<Icon name="github" size="1rem" />
			<span>{repo}</span>
		</a>
		<ThemeSelect />
	</div>
</div>

<style>
	.header-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		height: 100%;
		max-width: var(--as-frame-max);
		margin-inline: auto;
		padding-inline: var(--as-header-pad);
	}
	/* Leave room for the fixed menu button. */
	:global([data-has-sidebar]) .header-row {
		padding-inline-end: calc(var(--as-header-pad) + var(--sl-menu-button-size) + 0.5rem);
	}
	.title-wrapper {
		/* Clip long titles, but not the focus ring around the link. */
		overflow: clip;
		min-width: 0;
		margin: -0.25rem;
		padding: 0.25rem;
	}
	.right-group {
		display: none;
	}
	@media (min-width: 50rem) {
		.header-row,
		:global([data-has-sidebar]) .header-row {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			padding-inline-end: var(--as-header-pad);
		}
		.right-group {
			display: flex;
			justify-self: end;
			align-items: center;
			gap: 1rem;
		}
	}
	.repo-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		border-radius: 0.375rem;
		font-size: var(--sl-text-sm);
		line-height: 1.25rem;
		color: var(--as-header-link);
		text-decoration: none;
		white-space: nowrap;
	}
	.repo-link:hover {
		color: var(--sl-color-white);
	}
	.repo-link span {
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
